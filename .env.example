# ============================================================
# OnlyNerds — Environment Variables Template
# ============================================================
# Copy to .env and fill in your values before deploying.
# ============================================================

# R2 Public bucket URL — serves compressed job chunk files
R2_PUBLIC_BASE=https://your-bucket-id.r2.dev

# D1 Database — serverless SQLite for job search/stats
D1_DATABASE_ID=your-d1-database-uuid
D1_DATABASE_NAME=your-d1-database-name

# Cloudflare API Token (used by wrangler for deployment)
# Generate at: https://dash.cloudflare.com → My Profile → API Tokens
# Needed permissions: D1:Edit, Workers R2 Storage:Edit
# CLOUDFLARE_API_TOKEN=

# Cloudflare Account ID (used by wrangler for deployment)
# Find this at: https://dash.cloudflare.com → Workers & Pages → right sidebar
# CLOUDFLARE_ACCOUNT_ID=
