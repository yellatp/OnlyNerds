---
const year = new Date().getFullYear();
---

<footer class="mt-auto py-16" style="border-top: 0.5px solid #323028;">
  <div class="mx-auto max-w-7xl px-6 sm:px-10">

    <div class="mb-10 flex flex-col gap-10 lg:flex-row lg:gap-0">

      <!-- Logo — 25% -->
      <div class="flex shrink-0 items-start lg:w-[25%] lg:pr-6">
        <a href="/">
          <img
            src="/OnlyNerds.svg"
            alt="OnlyNerds"
            class="w-auto transition-opacity duration-300 hover:opacity-100"
            style="height: clamp(6rem, 18vw, 14rem); opacity: 0.9;"
            onerror="this.onerror=null;this.src='/OnlyNerds.png'"
          />
        </a>
      </div>

      <!-- Pages — 25% -->
      <div class="lg:w-[25%] lg:pr-6">
        <p class="mb-4 font-mono text-[10px] font-semibold uppercase tracking-[0.22em] text-slate-400">Pages</p>
        <div class="flex flex-col gap-2">
          {[
            { href: '/companies',      label: 'Companies'     },
            { href: '/companies-search', label: 'ATS Lookup'  },
            { href: '/job-search',     label: 'Dork Builder'  },
            { href: '/resources',      label: 'Resources'     },
          ].map((l) => (
            <a href={l.href}
              class="font-mono text-[11px] uppercase tracking-[0.12em] text-slate-500 transition-colors hover:text-slate-300">
              {l.label}
            </a>
          ))}
        </div>
      </div>

      <!-- Creator — 25% -->
      <div class="lg:w-[25%] lg:pr-6">
        <p class="mb-5 font-mono text-[10px] font-semibold uppercase tracking-[0.22em] text-slate-400">Creator</p>
        <p class="mb-0.5 font-sans text-sm font-semibold text-slate-100 transition-colors hover:text-white">Pavan Yellathakota</p>
        <p class="mb-1 font-mono text-xs text-slate-400">Data Scientist &amp; ML Practitioner</p>
        <p class="mb-5 font-mono text-xs" style="color:#16a34a;">Co-founder, Alphonso AI</p>
        <div class="flex flex-wrap gap-2">
          {[
            { href: 'https://pye.pages.dev',                  label: 'Portfolio',     external: true  },
            { href: 'https://linkedin.com/in/yellatp',        label: 'LinkedIn',      external: true  },
          ].map((l) => (
            <a
              href={l.href}
              target="_blank"
              rel="noopener noreferrer"
              class="font-mono text-[10px] uppercase tracking-[0.1em] text-slate-400 transition-colors duration-200 hover:text-slate-100 px-2.5 py-1.5"
              style="border: 0.5px solid #323028;"
              onmouseover="this.style.borderColor='#706E66'"
              onmouseout="this.style.borderColor='#323028'"
            >
              {l.label}
            </a>
          ))}
        </div>
      </div>

      <!-- Built With — 25% -->
      <div class="lg:w-[25%]">
        <p class="mb-5 font-mono text-[10px] font-semibold uppercase tracking-[0.22em] text-slate-400">Built in Association With</p>
        <a
          href="https://alphonso.app/"
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center gap-2.5 px-3 py-2.5 transition-all duration-300 hover:bg-slate-800"
          style="border: 0.5px solid #323028;"
          onmouseover="this.style.borderColor='#706E66'"
          onmouseout="this.style.borderColor='#323028'"
        >
          <img src="/Alphonso_logo.png" alt="Alphonso AI" class="h-6 w-6 object-contain" />
          <span class="flex items-baseline gap-0">
            <span class="px-1.5 py-0.5 text-sm font-bold leading-none" style="background:#ffffff;color:#111111;">Alphonso</span>
            <span class="px-1.5 py-0.5 text-sm font-bold leading-none" style="background:#16a34a;color:#ffffff;">AI</span>
          </span>
        </a>
      </div>

    </div>

    <!-- Bottom bar -->
    <div
      class="flex flex-col gap-3 pt-6 sm:flex-row sm:items-center sm:justify-between"
      style="border-top: 0.5px solid #323028;"
    >
      <p class="font-mono text-xs leading-relaxed text-slate-400">
        Career intelligence for people who do their homework. Free, community-built, no sign-ups.
      </p>
      <div class="flex flex-col gap-1 sm:items-end">
        <p class="font-mono text-[10px] uppercase tracking-[0.1em] text-slate-400">
          &copy; {year} OnlyNerds.
        </p>
      </div>
    </div>

  </div>
</footer>
