---
export interface Props {
  id: string;
  colorClass: string;
  title: string;
}
const { id, colorClass, title } = Astro.props;
---

<div id={id} data-modal class="modal-panel fixed inset-0 z-50 hidden items-start justify-center overflow-y-auto py-8 px-4">
  <div class="relative w-full max-w-5xl rounded-2xl border border-slate-700 bg-[#0d0d1a] shadow-2xl">
    <div class="sticky top-0 z-10 flex items-center justify-between rounded-t-2xl border-b border-slate-800 bg-[#0d0d1a] px-6 py-4">
      <div class="flex items-center gap-2">
        <span class={`h-1.5 w-1.5 rounded-full bg-${colorClass}-400`}></span>
        <h2 class={`text-sm font-bold uppercase tracking-widest text-${colorClass}-400`}>{title}</h2>
      </div>
      <button type="button" data-close class="rounded-lg p-1.5 text-slate-400 hover:bg-slate-800 hover:text-white transition-colors">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
      </button>
    </div>
    <slot />
  </div>
</div>

<style>
  .modal-panel.is-open {
    display: flex;
  }
</style>
