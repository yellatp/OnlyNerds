---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="OnlyNerds Jobs"
  description="Aggregated tech job listings from top ATS platforms"
  keywords="tech jobs, onlynerds jobs, software engineering, data science"
>
  <slot name="head">
    <meta http-equiv="refresh" content="0;url=/jobs">
  </slot>

  <div class="min-h-screen flex items-center justify-center bg-slate-950 px-6 py-16">
    <div class="mx-auto max-w-3xl rounded-[2rem] border border-slate-800 bg-slate-900/90 p-10 text-center">
      <p class="mb-4 text-sm uppercase tracking-[0.26em] text-slate-500">Jobs have moved</p>
      <h1 class="mb-6 text-4xl font-black tracking-tight text-slate-100">Redirecting to Jobs...</h1>
      <p class="text-slate-400">
        The job board is now at <a href="/jobs" class="text-slate-100 underline">/jobs</a>
      </p>
    </div>
  </div>
</Layout>

<script is:inline>
  location.href = '/jobs';
</script>
